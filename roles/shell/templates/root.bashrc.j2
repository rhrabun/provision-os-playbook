# Managed by provision-os-playbook. Changes are overwritten on the next run.
# The user account is managed by chezmoi; this file is only for root.

# Do nothing in non-interactive shells.
case $- in
    *i*) ;;
      *) return ;;
esac

# History
HISTCONTROL=ignoreboth
HISTSIZE=1000
HISTFILESIZE=2000
shopt -s histappend checkwinsize

export EDITOR=vim

# Red prompt: root should never look like a normal user shell.
PS1='\[\e[01;31m\]\u@\h\[\e[00m\]:\[\e[01;31m\]\w\[\e[00m\]\# '

# Colors for tools that read LS_COLORS.
if command -v dircolors >/dev/null 2>&1; then
    eval "$(dircolors -b)"
fi

# Jump around with zoxide, when it is installed.
if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init bash --cmd cd)"
fi
